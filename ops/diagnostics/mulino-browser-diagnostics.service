[Unit]
Description=Mulino browser diagnostics (read-only observer)
After=docker.service
Wants=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/mulino-browser-diagnostics/collector.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077
LogsDirectory=mulino-browser-diagnostics
LogsDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/log/mulino-browser-diagnostics
InaccessiblePaths=/opt/mulino-libero/data /opt/mulino-libero/secrets /opt/mulino-libero/.env

[Install]
WantedBy=multi-user.target
